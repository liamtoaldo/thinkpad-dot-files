[colors]
background = #2e3440
background-alt = #3b4252
foreground = #d8dee9
primary = #88c0d0
secondary = #a3be8c
tertiary = #F0C674
alert = #bf616a
disabled = #81a1c1

[bar/example]
width = 100%
height = 27pt
radius = 6

;dpi = 96
bottom = true

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3pt

border-size = 11pt
border-color = #00000000

padding-left = 1
padding-right = 0

module-margin = 1

separator =
separator-foreground = ${colors.disabled}


font-0 = Hack:size=12
font-1 = FontAwesome6FreeSolid:pixelsize=12;1
font-2 = FontAwesome6FreeRegular:pixelsize=12;1
font-3 = FontAwesome6Brands:pixelsize=8;1

modules-left = powermenu xworkspaces xwindow
modules-right = brightness memory cpu pulseaudio powerprofile battery date

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

tray-position = center
tray-padding = 0
margin-bottom = 40%
margin-top = 0

; wm-restack = generic
; wm-restack = bspwm
; wm-restack = i3

;override-redirect = true

[module/xworkspaces]
type = internal/xworkspaces

label-active = %name%
label-active-background = ${colors.background-alt}
label-active-underline= ${colors.primary}
label-active-padding = 1

label-occupied = %name%
label-occupied-padding = 1

label-urgent = %name%
label-urgent-background = ${colors.alert}
label-urgent-padding = 1

label-empty = %name%
label-empty-foreground = ${colors.disabled}
label-empty-padding = 1

[module/xwindow]
type = internal/xwindow
label = %{F#a3be8c}%title:0:60:...%%{F-}

[module/filesystem]
type = internal/fs
interval = 25

mount-0 = /

label-mounted = %{F#F0C674}%{F-} %percentage_used%%

label-unmounted = %mountpoint% not mounted
label-unmounted-foreground = ${colors.disabled}

[module/pulseaudio]
type = internal/pulseaudio

format-volume-prefix = "%{F#F0C674} %{F-}"
format-volume-prefix-foreground = ${colors.primary}
format-volume = <label-volume>

label-volume = %percentage%%

label-muted = %{F#F0C674}%{F-}
label-muted-foreground = ${colors.disabled}

[module/xkeyboard]
type = internal/xkeyboard
blacklist-0 = num lock

label-layout = %layout%
label-layout-foreground = ${colors.primary}

label-indicator-padding = 2
label-indicator-margin = 1
label-indicator-foreground = ${colors.background}
label-indicator-background = ${colors.secondary}

[module/memory]
type = internal/memory
interval = 2
format-prefix = "%{F#F0C674}%{F-} "
format-prefix-foreground = ${colors.primary}
label = %used:2%

[module/cpu]
type = internal/cpu
interval = 2
format-prefix = "%{F#F0C674}%{F-} "
format-prefix-foreground = ${colors.primary}
label = %percentage:2%%

[network-base]
type = internal/network
interval = 5
format-connected = <label-connected>
format-disconnected = <label-disconnected>
label-disconnected = %{F#F0C674}Ethernet%{F#707880} disconnected

[module/wlan]
inherit = network-base
interface-type = wireless
label-connected = %{F#F0C674}Wi-fi%{F-} %essid%

[module/eth]
inherit = network-base
interface-type = wired
label-connected = %{F#F0C674}Ethernet%{F-}

[module/date]
type = internal/date
interval = 1

date = %H:%M
date-alt = %d/%m/%Y %H:%M:%S

label = %date%
label-foreground = ${colors.foreground}

[module/powerprofile]
type = custom/script
exec = ~/.config/polybar/polybar-scripts/cpu-powerprofile.sh
interval = 5
click-left = exec notify-send "CPU power" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor) / $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference) / turbo=$([ $(cat /sys/devices/system/cpu/intel_pstate/no_turbo) = 0 ] && echo on || echo off) / profile=$(cat /sys/firmware/acpi/platform_profile)"

[module/battery]
type = custom/script
exec = ~/.config/polybar/polybar-scripts/battery-combined-ramp-udev.sh
tail = true

[module/brightness]
type = custom/script
exec = ~/.config/polybar/polybar-scripts/brightnessctl.sh

scroll-up = exec brightnessctl set +5%
scroll-down = exec brightnessctl set 5%-
interval = 0.5

label = %output%
label-foreground = ${colors.foreground}

[module/powermenu]
type = custom/menu

format-foreground = ${colors.xcolor7}
format-background = ${colors.xcolor0}


label-open = ""
label-open-font = 4
label-close = ""
label-close-foreground = ${colors.foreground}
label-separator = " | "
label-separator-foreground = ${colors.disabled}


; reboot
menu-0-1 = 
menu-0-1-exec = loginctl reboot
menu-0-1-foreground = ${colors.tertiary}
; shutdown
menu-0-0 = ""
menu-0-0-exec = loginctl poweroff
menu-0-0-foreground = ${colors.alert}
; suspend
menu-0-2 = 
menu-0-2-exec = loginctl suspend
menu-0-2-foreground = ${colors.secondary}
; hibernate
menu-0-3 = 
menu-0-3-exec = loginctl hibernate
menu-0-3-foreground = ${colors.primary}
; logout
menu-0-4 = 
menu-0-4-exec = killall i3
menu-0-4-foreground = ${colors.disabled}


[settings]
screenchange-reload = true
pseudo-transparency = true

; vim:ft=dosini
